{
    "manifest_version": 3,
    "name": "SafePaste",
    "version": "0.1.0",
    "description": "Hides private details when you paste into AI chats.",
    "key": "",
    "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
    "permissions": ["storage", "activeTab"],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "SafePaste",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "options_page": "options/options.html",
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "content_scripts": [{
        "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
        "js": ["shared/constants.js", "content/redact.js", "content/restore.js", "content/ui.js", "content/main.js"],
        "run_at": "document_idle"
    }, {
        "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
        "js": ["content/clipboard.js"],
        "run_at": "document_start",
        "world": "MAIN"
    }],
    "web_accessible_resources": [{
        "resources": ["content/ui.css", "fonts/*"],
        "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]
    }]
}
